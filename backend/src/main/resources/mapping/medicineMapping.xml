<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.med.MedIdentify.dao.MedicineDao">

    <select id="selectMedByName" parameterType="java.lang.String" resultType="com.med.MedIdentify.bean.Medicine">
        select * from medicine where mname = #{mname}
    </select>


    <select id="selectMedByMid" parameterType="java.lang.String" resultType="com.med.MedIdentify.bean.Medicine">
        select * from medicine where mid = #{mid}
    </select>
</mapper>
